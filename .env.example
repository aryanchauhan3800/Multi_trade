# Environment Mode: DEVELOPMENT | PAPER_TRADING | LIVE
NODE_ENV=development
ENVIRONMENT_MODE=PAPER_TRADING

# Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_trading?schema=public

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
COOKIE_SECRET=super-secret-cookie-key-replace-in-production

# External Provider Configuration (Documented Broker API)
# For Binance:
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# For Alpaca Markets (Paper / Live):
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_API_URL=https://paper-api.alpaca.markets
ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/sip

# Payment Provider Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_KEY=
