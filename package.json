{
  "name": "nexus-exchange",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade original multi-asset trading and exchange platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@nexus/server",
    "dev:client": "npm run dev --workspace=@nexus/client",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=@nexus/core && npm run db:generate && npm run build --workspace=@nexus/server",
    "start:server": "node packages/server/dist/server.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "prisma db push --schema packages/server/prisma/schema.prisma",
    "db:deploy": "prisma db push --schema packages/server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/server/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^5.0.0"
  }
}
